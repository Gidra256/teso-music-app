{
  "expo": {
    "name": "TesoHub Music",
    "slug": "teso-tunes",
    "scheme": "tesohubmusic",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/tesohub-music.png",
    "splash": {
      "image": "./assets/images/tesohub-music.png",
      "resizeMode": "contain",
      "backgroundColor": "#050506"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.tesotunes.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tesohub-music.png",
        "backgroundColor": "#050506"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "24fa8927-8f4c-4358-b1e7-80a33c2ddcc7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/24fa8927-8f4c-4358-b1e7-80a33c2ddcc7"
    },
    "ios": {}
  }
}
